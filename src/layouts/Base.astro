---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Code-to-Video 项目展示台：浏览预览、阅读分析、访问原始来源。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Code-2-Video-Lab</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><span class="mark">Code-2-Video-Lab</span><span class="sub">代码生成视频项目展示台</span></a>
        <span class="header-meta"><a href="/decision-report/" target="_blank" rel="noopener noreferrer">选型报告</a><span class="dot">·</span><a href="/about/">关于</a><span class="dot">·</span><a href="https://github.com/MavCui/Code-2-Video-Lab" target="_blank" rel="noopener noreferrer">GitHub</a></span>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap">本站为项目整理与展示，分析为本站判断；样片与截图权利归原作者，来源见各项目详情页。<span class="foot-links"><a href="/decision-report/" target="_blank" rel="noopener noreferrer">选型报告</a> · <a href="/about/">关于</a> · <a href="https://github.com/MavCui/Code-2-Video-Lab" target="_blank" rel="noopener noreferrer">GitHub</a></span></div>
    </footer>
  </body>
</html>
