---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('studies');
  return all
    .filter((s) => s.data.status === 'published')
    .map((s) => ({ params: { slug: s.data.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
const d = entry.data;
const all = await getCollection('studies');
const nameBySlug = Object.fromEntries(
  all.filter((s) => s.data.status === 'published').map((s) => [s.data.slug, s.data.title_main])
);
const hasCost = (d.cost_table ?? []).length > 0;
const head = d.cost_table?.[0] ?? [];
---

<Base title={d.title_main} description={d.one_liner}>
  <main class="wrap detail">
    <a class="back" id="back-link" href="/">← 返回项目展厅</a>

    <section class="detail-head">
      <div class="case-num">精读 {d.num} / 24 · {d.tag} · 来自《{d.source_doc?.name}》</div>
      <h1>{d.title}</h1>
      <p class="one">{d.one_liner}</p>
      <div class="tag-rows">
        <div class="tag-row">
          <span class="label">行业</span>
          <span class="card-tags"><span class="tag accent">{d.industry}</span></span>
        </div>
        <div class="tag-row">
          <span class="label">技术栈</span>
          <span class="card-tags">{(d.tech ?? []).map((t) => <span class="tag">{t}</span>)}</span>
        </div>
        <div class="tag-row">
          <span class="label">证据类型</span>
          <span class="card-tags"><span class="tag">案例精读 · 含成本与口径</span></span>
        </div>
      </div>
    </section>

    <section class="media-main">
      {d.preview_motion ? (
        <video
          class="detail-media-video"
          src={d.preview_motion}
          poster={d.cover?.file}
          autoplay muted loop playsinline preload="metadata"
          aria-label={`${d.title_main} 原片片段`}
        ></video>
      ) : (
        <img
          class:list={['detail-media-img', d.cover?.fit === 'contain' && 'fit-contain']}
          src={d.cover?.file}
          alt={d.cover?.alt ?? ''}
        />
      )}
      <div class="media-caption">
        {d.preview_motion ? '原片片段 · 5 秒静音循环，取自作者 X 原帖视频，非本站复现' : d.caption}
      </div>
    </section>

    {d.preview_motion && d.cover?.fit === 'contain' && (
      <section class="media-main media-secondary">
        <img class="detail-media-img fit-contain" src={d.cover?.file} alt={d.cover?.alt ?? ''} />
        <div class="media-caption">{d.caption}</div>
      </section>
    )}

    <nav class="outlinks" aria-label="外部来源">
      {d.demo?.url && (
        <a class:list={['outlink', 'primary', d.demo.note && 'is-broken']} href={d.demo.url} target="_blank" rel="noopener noreferrer">
          {d.demo.label} ↗{d.demo.note && '（原帖当前不可访问）'}
        </a>
      )}
      {d.source_doc?.url && <a class="outlink" href={d.source_doc.url} target="_blank" rel="noopener noreferrer">案例精读文档 ↗</a>}
    </nav>

    {d.demo?.note && (
      <p class="demo-warning"><strong>链接状态</strong>：{d.demo.note}</p>
    )}

    {d.hint && (
      <section class="section">
        <h2>看哪里</h2>
        <p>{d.hint}</p>
      </section>
    )}

    {(d.meta ?? []).length > 0 && (
      <section class="section">
        <h2>链路拆解</h2>
        <div class="scroll">
          <table class="registry">
            <tbody>
              {(d.meta ?? []).map((m) => (
                <tr><th>{m.k}</th><td>{m.v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {(d.body ?? []).length > 0 && (
      <section class="section">
        <h2>为什么值得看</h2>
        {(d.body ?? []).map((p) => <p>{p}</p>)}
      </section>
    )}

    {hasCost && (
      <section class="section">
        <h2>效果对照与成本</h2>
        <div class="scroll">
          <table class="cost-table">
            <thead>
              <tr>{head.map((c, i) => <th class={i === 0 ? 'rowhead' : ''}>{c}</th>)}</tr>
            </thead>
            <tbody>
              {(d.cost_table ?? []).slice(1).map((row) => (
                <tr>{row.map((c, i) => (i === 0 ? <th class="rowhead">{c}</th> : <td>{c}</td>))}</tr>
              ))}
            </tbody>
          </table>
        </div>
        {d.cost_note && <p class="cost-note">{d.cost_note}</p>}
      </section>
    )}

    {(d.take ?? []).length > 0 && (
      <section class="section">
        <h2>可复用点与适用边界</h2>
        <div class="take-grid">
          {(d.take ?? []).map((t) => (
            <div class="take-item">
              <div class="take-k">{t.k}</div>
              <p>{t.v}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <h2>来源与证据缺口</h2>
      <ul class="source-list">
        {(d.sources ?? []).map((s) => (
          <li>
            {s.text}
            {(s.links ?? []).filter((l) => !s.text.includes(l)).slice(0, 1).map((l) => (
              <> <a href={l} target="_blank" rel="noopener noreferrer">{l}</a></>
            ))}
          </li>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>使用边界</h2>
      <ul>
        <li>本文的耗时、成本、token 与调用次数均来自作者自述或案例精读文档的记录，本站未独立复现任何一条链路。</li>
        <li>不同案例的任务复杂度、成片时长与口径不同，成本数字不可跨案例直接排名或相除。</li>
        <li>画面版权归原作者；本地截图副本仅供展示台引用，公开托管或商用前需单独确认。</li>
      </ul>
    </section>

    <section class="section">
      <h2>媒体与许可登记</h2>
      <p style="font-size:13px;color:var(--muted)">作品许可与预览媒体使用依据分开登记；后者不由前者推导。</p>
      <div class="scroll">
        <table class="registry">
          <thead><tr class="group"><th colspan="2">作品许可（作者保留权利）</th></tr></thead>
          <tbody>
            <tr><th>SPDX</th><td>{d.license?.spdx}</td></tr>
            <tr><th>许可 / 说明来源</th><td><a href={d.license?.source} target="_blank" rel="noopener noreferrer">{d.license?.source}</a></td></tr>
            <tr><th>覆盖说明</th><td>{d.license?.note}</td></tr>
          </tbody>
          <thead><tr class="group"><th colspan="2">预览媒体使用依据（逐条单独登记）</th></tr></thead>
          <tbody>
            {(d.media_records ?? []).map((m) => (
              <>
                <tr><th>素材</th><td><strong>{m.sample_name}</strong> · {m.kind} · <a href={m.file} target="_blank" rel="noopener noreferrer">{m.file}</a></td></tr>
                <tr><th>权利方 / 署名</th><td>{m.rights_holder} · {m.attribution}</td></tr>
                <tr><th>使用依据</th><td>{m.usage_basis}</td></tr>
                <tr><th>来源</th><td><a href={m.source_url} target="_blank" rel="noopener noreferrer">{m.source_url}</a></td></tr>
                <tr><th>备注</th><td>{m.permission_note ?? '—'}</td></tr>
              </>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section">
      <h2>来源与更新时间</h2>
      <div class="facts">
        <div class="fact"><span class="k">原始 Demo</span><span class="v">{d.demo?.label}</span></div>
        <div class="fact"><span class="k">Demo 类型</span><span class="v">{d.demo?.type}</span></div>
        <div class="fact"><span class="k">精读文档</span><span class="v">{d.source_doc?.name} · {d.source_doc?.section}</span></div>
        <div class="fact"><span class="k">本站更新日期</span><span class="v">{d.updated_at}</span></div>
        <div class="fact"><span class="k">来源核验说明</span><span class="v">{d.verification_note}</span></div>
      </div>
    </section>

    {(d.related ?? []).length > 0 && (
      <section class="section">
        <h2>相关精读</h2>
        <div class="related">{(d.related ?? []).map((r) => <a href={`/studies/${r}/`}>{nameBySlug[r] ?? r} ↗</a>)}</div>
      </section>
    )}
  </main>
</Base>

<script is:inline>
(function () {
  try {
    var s = JSON.parse(sessionStorage.getItem('c2v_list_state') || '{}');
    var back = document.getElementById('back-link');
    if (back) {
      var u = new URL('/', location.origin);
      if (s.q) u.searchParams.set('q', s.q);
      if (s.ind && s.ind !== '全部') u.searchParams.set('ind', s.ind);
      if (s.tech && s.tech !== '全部') u.searchParams.set('tech', s.tech);
      if (s.kind && s.kind !== 'all') u.searchParams.set('kind', s.kind);
      back.setAttribute('href', u.pathname + u.search);
      back.addEventListener('click', function () { sessionStorage.setItem('c2v_return', '1'); });
    }
  } catch (e) {}
  document.querySelectorAll('.detail-media-img').forEach(function (img) {
    img.addEventListener('error', function () {
      var cap = document.createElement('div');
      cap.className = 'media-caption';
      cap.textContent = '预览加载失败，请通过上方原始 Demo 链接访问原始画面。';
      img.replaceWith(cap);
    });
  });
})();
</script>
